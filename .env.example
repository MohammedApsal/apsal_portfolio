# Server-only configuration. Never use VITE_ for secrets.
# Add these in the host's project environment variables, then redeploy.
GEMINI_API_KEY=
# Optional model overrides. Defaults: gemini-3.5-flash-lite, then gemini-3.6-flash.
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
# Optional secure n8n enquiry delivery. Both values are required.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=
# Choose apps-script only after deploying and testing the replacement.
# Leaving this unset retains the existing n8n integration for rollback.
ENQUIRY_PROVIDER=
ENQUIRY_APPS_SCRIPT_URL=
# Random server-only signing secret, at least 32 characters, also in Script Properties.
ENQUIRY_APPS_SCRIPT_SECRET=
